# ============================================================
#  SentinelIQ AI Safety Platform — Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit the .env file to version control.
# ============================================================

# ── Security ────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_strong_64char_hex_secret

# Internal service secret shared between MediaMTX and FastAPI
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_YOLO_SECRET=CHANGE_ME_generate_a_strong_internal_secret

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# For local dev: http://localhost:5173
# For production: https://yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ────────────────────────────────────────────────
# Leave empty to use embedded SQLite (default, good for dev/single-node).
# Set to a PostgreSQL URL for production multi-tenant deployment:
# DATABASE_URL=postgresql://user:password@host:5432/sentineliq_db
DATABASE_URL=

# ── Redis / Celery ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Server ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000

# Enable TLS (requires auto.crt and auto.key in project root)
# Set to "true" for HTTPS in production
TLS_ENABLED=false
TLS_CERT_FILE=auto.crt
TLS_KEY_FILE=auto.key

# ── Frontend (Vite build) ───────────────────────────────────
# Leave empty in development (uses Vite proxy).
# Set to your backend URL for production builds:
# VITE_API_URL=https://api.yourdomain.com
VITE_API_URL=

# ── Token Expiry ────────────────────────────────────────────
# JWT access token lifetime in minutes (default: 1440 = 24h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Multi-Tenancy (SaaS) ────────────────────────────────────
# Set to "true" to enable multi-tenant mode.
# In single-tenant mode, all users share tenant_id = "default"
MULTI_TENANT_MODE=false

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO
